# Configuración del Backend - Hotel System
# Copia este archivo como .env y reemplaza los valores

# MongoDB - Opción 1: Local
MONGO_URI=mongodb://127.0.0.1:27017/HotelSystem

# MongoDB - Opción 2: Atlas (Cloud) - RECOMENDADO PARA PRODUCCIÓN
# MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.xxxxx.mongodb.net/HotelSystem?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret - Genera una clave secreta única y fuerte
# Puedes usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA

# Node Environment
NODE_ENV=development

# Puerto del servidor (Render lo asigna automáticamente)
PORT=5000

# Frontend URL - Para CORS
# Development: http://localhost:5173
# Production (Vercel): https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Resend Email Configuration (opcional - para envío de emails)
# Obtén tu API Key en: https://resend.com/api-keys
RESEND_API_KEY=re_TU_API_KEY_AQUI
EMAIL_FROM=Hotel System <onboarding@resend.dev>
# Frontend URL (para enlaces en emails)
FRONTEND_URL=http://localhost:5173

# ⚠️ IMPORTANTE:
# 1. Nunca subas este archivo .env a GitHub
# 2. Genera credenciales únicas y fuertes
# 3. Rota tus secretos periódicamente
# 4. En producción usa variables de entorno del servidor
